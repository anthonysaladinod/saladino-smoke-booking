# Saladino Smoke Booking App — Environment Variables
# Copy this file to .env and fill in your values.
# These values are referenced in the Google Apps Script backend (Code.gs).

# Google Apps Script Web App URL (deployed from Code.gs)
APPS_SCRIPT_URL=

# Google Calendar ID for catering bookings
# Use 'primary' for the main calendar, or a specific calendar ID
GOOGLE_CALENDAR_ID=primary

# Google Sheets ID for the booking dashboard
# Create a new Google Sheet and paste the ID from the URL
# (the long string between /d/ and /edit in the URL)
GOOGLE_SHEET_ID=

# Notification email for new booking alerts
NOTIFICATION_EMAIL=catering@saladinosmoke.com

# Stripe (optional — for $100 deposit collection)
# Create a Stripe account, then get your keys from the Dashboard
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=

# Domain where the app is hosted (for Stripe redirect URLs)
SITE_URL=https://www.saladinosmoke.com
